<?xml version="1.0" encoding="utf-8"?>
<!-- Pins the package source for SilentBA and the wix tool, so builds don't depend on machine NuGet settings. -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>

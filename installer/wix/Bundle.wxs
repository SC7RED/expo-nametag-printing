<?xml version="1.0" encoding="utf-8"?>
<!--
  ExpoNametagSetup.exe: installs DYMO Label Software 8.7.4, then the app MSI, with no UI except one UAC prompt.
  ExpoNametag.env (the laptop settings) must be next to it on a first install.
  Built by installer\build-installer.ps1:
    wix build Bundle.wxs -ext WixToolset.Util.wixext -d BADir=<SilentBA output> -d MsiPath=<ExpoNametag.msi> -d Version=1.0.0
-->
<?ifndef Version?>
<?define Version = 1.0.0?>
<?endif?>
<?ifndef BADir?>
<?error Pass -d BADir=<folder with SilentBA.exe>?>
<?endif?>
<?ifndef MsiPath?>
<?error Pass -d MsiPath=<path to ExpoNametag.msi>?>
<?endif?>

<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">
  <Bundle Name="Expo Nametag Printing"
          Manufacturer="SEC at VT"
          Version="$(var.Version)"
          UpgradeCode="{92C139E7-56AB-499C-AC03-3608FD664B09}"
          DisableModify="yes">

    <!-- WiX v5 managed BA: its own .NET Framework exe, started by Burn out of process. See SilentBA\. -->
    <BootstrapperApplication SourceFile="$(var.BADir)\SilentBA.exe">
      <Payload SourceFile="$(var.BADir)\SilentBA.exe.config" />
      <Payload SourceFile="$(var.BADir)\WixToolset.BootstrapperApplicationApi.dll" />
      <Payload SourceFile="$(var.BADir)\mbanative.dll" />
    </BootstrapperApplication>

    <!-- 1 when DYMO was installed before this bundle; SilentBA then leaves it alone on uninstall. -->
    <Variable Name="DymoPreinstalled" Type="numeric" Value="0" Persisted="yes" />

    <util:ProductSearch Variable="DymoLabelVersion" Result="version"
                        UpgradeCode="{5559A9AC-1B2D-44F6-82A0-B1DD71F2CA16}" />

    <Chain>
      <!--
        DYMO's installer is proprietary, so it is not embedded: Burn uses DLS8Setup8.7.4.exe from
        next to Setup.exe if it's there, otherwise downloads it and checks Size and Hash (SHA-512).
        InstallShield switches: /s silent, /w wait for the MSI, /f2 InstallShield's own log,
        /v passes options to msiexec (inner quotes escaped as \"). Both logs go next to the
        bundle's log, because InstallShield's exit code doesn't always report a failure.
        /clone_wait: DLS8Setup starts a second copy of itself and exits after a few seconds,
        while the copy installs for a minute or more; this makes it wait for the copy. Without
        it, Burn reported DYMO done while it was still installing (seen in the Windows 11 VM).
      -->
      <ExePackage Id="DYMO"
                  DisplayName="DYMO Label Software 8.7.4"
                  PerMachine="yes"
                  Vital="yes"
                  DetectCondition="DymoLabelVersion &gt;= v8.7.4"
                  InstallArguments='/s /w /clone_wait /f2"[WixBundleLog_DYMO].setup.log" /v"/qn REBOOT=ReallySuppress /l*v \"[WixBundleLog_DYMO]\""'
                  UninstallArguments='/s /w /clone_wait /x /f2"[WixBundleLog_DYMO].setup.log" /v"/qn REBOOT=ReallySuppress /l*v \"[WixBundleLog_DYMO]\""'>
        <!-- Generated by: wix burn remotepayload -packagetype exe -du <url> DLS8Setup8.7.4.exe -->
        <ExePackagePayload Name="DLS8Setup8.7.4.exe"
                           ProductName="DYMO Label"
                           Description="DYMO Label Installer"
                           DownloadUrl="https://download.dymo.com/dymo/Software/Win/DLS8Setup8.7.4.exe"
                           Hash="6F8F46A94DD8A6FB06E37748104A4E17EA992DAC9C4A77DF9604BF9439C018A269431AF6C732E2FB12C96D00DA79EC7DDA21D10CAEBD4801BD1DAC967EFC2C47"
                           Size="171002016"
                           Version="8.7.4.48936" />
        <ExitCode Value="3010" Behavior="scheduleReboot" />
        <ExitCode Value="1641" Behavior="scheduleReboot" />
      </ExePackage>

      <!-- This exe's own folder: the MSI copies the ExpoNametag.env found there (see Package.wxs). -->
      <MsiPackage Id="App" SourceFile="$(var.MsiPath)">
        <MsiProperty Name="ENVSOURCEDIR" Value="[WixBundleOriginalSourceFolder]" />
      </MsiPackage>
    </Chain>
  </Bundle>
</Wix>

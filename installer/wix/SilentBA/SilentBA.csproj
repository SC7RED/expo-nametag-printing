<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Burn bootstrapper application with no UI, for WiX v5.0.2. In v5 a managed BA is its own
    32-bit exe that Burn starts out of process (WixToolset.BootstrapperApplicationApi).
  -->
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <OutputType>WinExe</OutputType>
    <AssemblyName>SilentBA</AssemblyName>
    <RootNamespace>ExpoNametag.SilentBA</RootNamespace>
    <!-- mbanative.dll is native code, so the exe and the DLL must both be x86. -->
    <RuntimeIdentifier>win-x86</RuntimeIdentifier>
    <PlatformTarget>x86</PlatformTarget>
    <SelfContained>false</SelfContained>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <DebugType>embedded</DebugType>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="WixToolset.BootstrapperApplicationApi" Version="5.0.2" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <Reference Include="System.Windows.Forms" />
  </ItemGroup>
</Project>

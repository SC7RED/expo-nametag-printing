# Address of the Cloudflare Worker that does the Swapcard lookups (see proxy/README.md)
PROXY_URL="https://expo-nametag.your-subdomain.workers.dev"

# The Worker's LAPTOP_TOKEN (not the Swapcard API key, which stays on Cloudflare)
PROXY_TOKEN="your_laptop_token_here"

# IDs of this year's Swapcard Major and School Year fields
SWAPCARD_YEAR_ID="your_field_id_here"
SWAPCARD_MAJOR_ID="your_field_id_here"
